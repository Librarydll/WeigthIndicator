<UserControl
    x:Class="WeigthIndicator.Views.PrintPreviewViewEng"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WeigthIndicator.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="540"
    Height="500"
    FontFamily="Arial">
    <Grid Background="White">
        <FlowDocumentPageViewer Margin="0">
            <FlowDocument
                x:Name="FD"
                LineHeight="10"
                PagePadding="5 20 0 0">
                <FlowDocument.Resources>
                    <Style TargetType="Run">
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="FontFamily" Value="Arial" />
                    </Style>
                </FlowDocument.Resources>
                <Paragraph FontSize="15" LineHeight="1">
                    <TextBlock TextAlignment="Left" TextWrapping="Wrap">
                        <Run Text="Наименование:" />
                        <Run
                            x:Name="NameRu"
                            FontSize="15"
                            FontWeight="ExtraBold"
                            Text="Сок виноградный концентрированный осветленный" />
                    </TextBlock>
                </Paragraph>
                <Paragraph FontSize="15" LineHeight="1">
                    <TextBlock TextAlignment="Left" TextWrapping="Wrap">
                        <Run Text="Product:" />
                        <Run
                            x:Name="NameKz"
                            FontSize="15"
                            FontWeight="ExtraBold"
                            Text="Сок виноградный концентрированный осветленный" />
                    </TextBlock>
                </Paragraph>

                <Table LineHeight="1">
                    <Table.Columns>
                        <TableColumn Width="320" />
                        <TableColumn Width="90" />
                        <TableColumn Width="auto" />
                    </Table.Columns>

                    <TableRowGroup>
                        <TableRow>
                            <TableCell>
                                <Paragraph LineHeight="1">
                                    <Run Text="Номер партии/Lot No:" />
                                </Paragraph>
                            </TableCell>
                            <TableCell TextAlignment="Justify">
                                <Paragraph LineHeight="1">
                                    <Run x:Name="BatchNumber" />
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="0,0,5,0" TextAlignment="Left">
                                <Paragraph LineHeight="1">
                                    <Run Text="Брикс/Brix" />
                                    <Run x:Name="Brix" />
                                </Paragraph>
                            </TableCell>
                        </TableRow>
                    </TableRowGroup>
                </Table>

                <Table LineHeight="1">
                    <Table.Columns>
                        <TableColumn Width="320" />
                        <TableColumn Width="90" />
                        <TableColumn Width="auto" />
                    </Table.Columns>

                    <TableRowGroup>
                        <TableRow>
                            <TableCell>
                                <Paragraph LineHeight="1">
                                    <Run Text="Номер бочки/Drum No:" />
                                </Paragraph>
                            </TableCell>
                            <TableCell TextAlignment="Justify">
                                <Paragraph LineHeight="1">
                                    <Run
                                        x:Name="BarrelNumber"
                                        FontSize="16"
                                        FontWeight="ExtraBold" />
                                </Paragraph>
                            </TableCell>
                            <TableCell TextAlignment="Left">
                                <Paragraph LineHeight="1">
                                    <Run Text="Гост 32102-2013" />
                                </Paragraph>
                            </TableCell>
                        </TableRow>
                    </TableRowGroup>
                </Table>

                <Table LineHeight="1">
                    <Table.Columns>
                        <TableColumn Width="320" />
                        <TableColumn Width="90" />
                        <TableColumn Width="auto" />
                    </Table.Columns>

                    <TableRowGroup>
                        <TableRow>
                            <TableCell>
                                <Paragraph LineHeight="1">
                                    <Run Text="Дата производства/Date of production:" />
                                </Paragraph>
                            </TableCell>
                            <TableCell TextAlignment="Justify">
                                <Paragraph LineHeight="1">
                                    <Run x:Name="ProductionDate" />
                                </Paragraph>
                            </TableCell>
                            <TableCell
                                Padding="0,0,50,0"
                                ColumnSpan="4"
                                RowSpan="3"
                                TextAlignment="Right">
                                <Paragraph>
                                    <Image Height="32" Source="/Resources/logoprint2.png" />
                                </Paragraph>
                            </TableCell>
                        </TableRow>
                        <TableRow>
                            <TableCell>
                                <Paragraph LineHeight="1">
                                    <Run Text="Годен до/Best before:" />
                                </Paragraph>
                            </TableCell>
                            <TableCell TextAlignment="Justify">
                                <Paragraph LineHeight="1">
                                    <Run x:Name="BeforeDate" />
                                </Paragraph>
                            </TableCell>
                            <TableCell TextAlignment="Justify">
                                <Paragraph LineHeight="1">
                                    <Run x:Name="PackingDate" />
                                </Paragraph>
                            </TableCell>
                        </TableRow>

                    </TableRowGroup>
                </Table>


                <Paragraph LineHeight="1">
                    <Run Text="Условия хранения/Storage condition:" />
                </Paragraph>
                <Paragraph LineHeight="1">
                    <TextBlock
                        x:Name="StorageCondition"
                        FontFamily="Arial"
                        FontSize="12.5"
                        FontWeight="Bold"
                        TextWrapping="Wrap" />
                </Paragraph>
                <Paragraph LineHeight="1">
                    <Run Text="Условия транспортировки/Transportation condition:" />
                </Paragraph>
                <Paragraph LineHeight="1">
                    <Run x:Name="TranportationCondition" />
                </Paragraph>
                <Table LineHeight="1">
                    <Table.Columns>
                        <TableColumn Width="195" />
                        <TableColumn />
                        <TableColumn />
                        <TableColumn />
                    </Table.Columns>

                    <TableRowGroup>
                        <TableRow>
                            <TableCell>
                                <Paragraph>Вес нетто/Net Wt:</Paragraph>
                            </TableCell>
                            <TableCell TextAlignment="Right">
                                <Paragraph>
                                    <Run
                                        x:Name="Net"
                                        FontSize="16"
                                        FontWeight="ExtraBold" />
                                </Paragraph>
                            </TableCell>
                            <TableCell
                                Padding="0,0,50,0"
                                RowSpan="2"
                                TextAlignment="Right">
                                <Paragraph>
                                    <Image
                                        Width="100"
                                        Height="30"
                                        Source="/Resources/logoprint.png" />
                                </Paragraph>
                            </TableCell>
                        </TableRow>
                        <TableRow>
                            <TableCell>
                                <Paragraph>
                                    <Run Text="Вес брутто/Gross Wt:" />
                                </Paragraph>
                            </TableCell>
                            <TableCell Padding="0,0,16,0" TextAlignment="Right">
                                <Paragraph>
                                    <Run x:Name="Brutto" />
                                </Paragraph>
                            </TableCell>
                        </TableRow>

                    </TableRowGroup>
                </Table>
                <Paragraph LineHeight="1">
                    <Run
                        FontSize="14"
                        FontWeight="ExtraBold"
                        Text="Производитель/Producer:" />
                    <Run
                        x:Name="ManufactureName"
                        FontSize="14"
                        FontWeight="ExtraBold"
                        Text="«AGROMIR» JV LLC/СП ООО «AGROMIR»" />
                </Paragraph>
                <Paragraph LineHeight="1">
                    <Run Text="Адрес производства/Manufacture address:" />
                    <Run x:Name="Index" Text="140300" />
                </Paragraph>
                <Paragraph LineHeight="1">
                    <Run x:Name="polandAddressName" Text="140300, Republic of Uzbekistan, Samarkand district, Samarkand region, Village Gulobod /140300" />
                </Paragraph>
                <Paragraph LineHeight="1">
                    <Run Text="Республика Узбекистан, Самаркандская область, Самаркандский район, п Гулобод" />
                </Paragraph>
                <Paragraph LineHeight="1">
                    <Run Text="Страна происхождения/Country of origin: Узбекистан/ Uzbekistan" />
                </Paragraph>

                <Paragraph LineHeight="1">
                    <Run Text="Импортер/Buyer:" />
                    <Run x:Name="Buyer" />
                </Paragraph>

                <!--<Paragraph LineHeight="1" />

                <Paragraph LineHeight="1">
                    <Run x:Name="AddressKz" />
                </Paragraph>-->
            </FlowDocument>
        </FlowDocumentPageViewer>
    </Grid>
</UserControl>
